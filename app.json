{
  "expo": {
    "name": "Bound",
    "slug": "bound",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bound",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0F1015"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bound.attendance",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.bound.attendance",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F1015"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3DDC84"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
