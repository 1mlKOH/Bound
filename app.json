{
  "expo": {
    "name": "Bound",
    "slug": "bound",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bound",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1015"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bound.attendance",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.bound.attendance",
      "versionCode": 1,
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1015"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3DDC84"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "789baf08-b4d7-4604-b794-0cdc2312bce0"
      }
    }
  }
}
