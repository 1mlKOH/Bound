<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bound_error_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_error"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/bound_error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bound · Tap to open"
        android:textColor="#F5F5F7"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/bound_error_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:text="Syncing widget state..."
        android:textColor="#A4A4B0"
        android:textSize="11sp" />

</LinearLayout>
